<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildToolsPath)\Microsoft.Common.props" Condition="Exists('$(MSBuildToolsPath)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>NareServerManager</RootNamespace>
    <AssemblyName>ServerManager</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>bin\SM\</OutputPath>
    <DefineConstants>SERVERMANAGER_EXE</DefineConstants>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="SMProgram.cs" />
    <Compile Include="SMForm.cs" />
    <Compile Include="SMNareNet.cs" />
    <Compile Include="Core\ServerManager.cs" />
    <Compile Include="Core\NareHost.cs" />
    <Compile Include="Core\Json.cs" />
    <Compile Include="Core\JavaLocator.cs" />
    <Compile Include="Core\ServerJar.cs" />
    <Compile Include="Core\ModrinthClient.cs" />
    <Compile Include="Core\Settings.cs" />
    <Compile Include="Core\Paths.cs" />
    <Compile Include="Core\Log.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
